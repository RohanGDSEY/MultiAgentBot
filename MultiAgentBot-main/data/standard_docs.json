      "age_46_60": ["Blood test", "ECG", "Urine test"],
      "age_61_plus": ["Blood test", "ECG", "Urine test", "Chest X-ray", "Stress test"]
    }
  },
  "life": {
    "required": [
      "Proposal Form",
      "KYC Documents (Aadhaar + PAN)",
      "Income Proof",
      "Age Proof",
      "Nominee Details with KYC",
      "Passport Size Photographs",
      "Medical Report"
    ],
    "optional": [
      "Financial Statement (for high SI)",
      "Medical Test Reports",
      "Employment Certificate",
      "Bank Statement (6 months)"
    ],
    "medical_tests_required": {
      "sum_insured_below_25L": ["Self declaration"],
      "sum_insured_25L_50L": ["Blood test", "Urine test"],
      "sum_insured_above_50L": ["Blood test", "Urine test", "ECG", "Chest X-ray"]
    }
  },
  "motor": {
    "required": [
