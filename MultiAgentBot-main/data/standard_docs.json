    "risk_assessment": {
      "property_survey": "Required for property above 1 Cr",
      "fire_audit": "Required for manufacturing units",
      "security_audit": "Required for high-value goods"
    }
  },
  "group_health": {
    "required": [
      "Master Policy Proposal",
      "Employee List with Details",
      "HR Letter",
